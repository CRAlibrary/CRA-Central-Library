  <script>
    function toggleMenu() {
      document.getElementById('mobileDrawer').classList.toggle('open');
    }
    function setEngine(btn, text) {
      document.querySelectorAll('.eng-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('searchInput').placeholder = text;
    }
    function setChip(btn) {
      document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
    }

    let hIdx = 0;
    const hSlides = document.querySelectorAll('.h-slide');
    const hDots = document.querySelectorAll('.h-dot');
    const hCount = document.getElementById('hSlideCount');

    function showHSlide(n) {
      hIdx = (n + hSlides.length) % hSlides.length;
      hSlides.forEach((s, i) => s.classList.toggle('active', i === hIdx));
      hDots.forEach((d, i) => d.classList.toggle('active', i === hIdx));
      hCount.textContent = `0${hIdx + 1} / 0${hSlides.length}`;
    }
    function nextSlide() { showHSlide(hIdx + 1); }
    function prevSlide() { showHSlide(hIdx - 1); }
    function goSlide(i) { showHSlide(i); }
  </script>
