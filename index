<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ห้องสมุดกลาง ราชวิทยาลัยจุฬาภรณ์ | CRA Central Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Prompt:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

  <style>
    /* รองรับฟอนต์จุฬาภรณ์ลิขิต (ดึงจากเครื่องอัตโนมัติหากติดตั้งไว้แล้ว หรือวางไฟล์ในโฟลเดอร์ fonts/) */
    @font-face {
      font-family: 'Chulabhorn Likhit Text';
      src: local('Chulabhorn Likhit Text'),
           local('ChulabhornLikhitText-Regular'),
           url('fonts/ChulabhornLikhitText-Regular.woff2') format('woff2'),
           url('fonts/ChulabhornLikhitText-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Chulabhorn Likhit Text';
      src: local('Chulabhorn Likhit Text Medium'),
           local('ChulabhornLikhitText-Medium'),
           url('fonts/ChulabhornLikhitText-Medium.woff2') format('woff2'),
           url('fonts/ChulabhornLikhitText-Medium.ttf') format('truetype');
      font-weight: 500 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Chulabhorn Likhit Text';
      src: local('Chulabhorn Likhit Text Bold'),
           local('ChulabhornLikhitText-Bold'),
           url('fonts/ChulabhornLikhitText-Bold.woff2') format('woff2'),
           url('fonts/ChulabhornLikhitText-Bold.ttf') format('truetype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --sky-600: #0284C7;
      --sky-500: #0EA5E9;
      --sky-400: #38BDF8;
      --sky-100: #E0F2FE;
      --sky-50: #F4FAFF;
      --ink-900: #0F172A;
      --ink-700: #334155;
      --ink-500: #64748B;
      --orange-500: #FF6900;
      --orange-400: #FF8533;
      --orange-50: #FFF4ED;
      --white: #FFFFFF;
      --border: #E2EEF8;
      --radius-xl: 24px;
      --radius-lg: 18px;
      --radius-md: 12px;
      --shadow-sm: 0 4px 16px -4px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 12px 32px -8px rgba(2, 132, 199, 0.12);
      --shadow-lg: 0 24px 56px -12px rgba(2, 132, 199, 0.16);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Chulabhorn Likhit Text', 'Prompt', 'Noto Sans Thai', sans-serif;
      color: var(--ink-700);
      background-color: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    a { text-decoration: none; color: inherit; }

    .container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* 1. Slim OpenAthens Bar */
    .openathens-bar {
      background: linear-gradient(90deg, #FFF4ED 0%, #FFEDD5 50%, #FFF4ED 100%);
      border-bottom: 1px solid #FED7AA;
      color: #9A3412;
      font-size: 13px;
      padding: 7px 16px;
      text-align: center;
      font-weight: 500;
    }
    .openathens-bar a {
      color: var(--orange-500);
      font-weight: 700;
      margin-left: 8px;
      padding: 2px 10px;
      background: var(--white);
      border-radius: 20px;
      box-shadow: 0 2px 6px rgba(255, 105, 0, 0.12);
      transition: all 0.2s;
    }
    .openathens-bar a:hover {
      background: var(--orange-500);
      color: var(--white);
    }

    /* 2. Floating Glass Header */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    }
    .nav-wrap {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 76px;
      gap: 16px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }
    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--sky-500), var(--sky-600));
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 16px rgba(2, 132, 199, 0.25);
    }
    .brand-text h1 {
      font-size: 16px;
      font-weight: 700;
      color: var(--ink-900);
      line-height: 1.2;
      white-space: nowrap;
    }
    .brand-text span {
      font-size: 11px;
      color: var(--ink-500);
      display: block;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 4px;
      align-items: center;
    }
    .nav-links a {
      font-size: 13.5px;
      font-weight: 500;
      color: var(--ink-700);
      padding: 8px 12px;
      border-radius: 10px;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .nav-links a:hover { background: var(--sky-50); color: var(--sky-600); }
    .nav-links a.active { color: var(--sky-600); font-weight: 600; background: var(--sky-100); }

    .nav-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .btn-mylibrary {
      background: var(--ink-900);
      color: var(--white);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 12.5px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-mylibrary:hover { background: var(--orange-500); transform: translateY(-1px); }
    .mobile-btn {
      display: none;
      background: var(--sky-50);
      border: 1px solid var(--border);
      color: var(--sky-600);
      width: 40px;
      height: 40px;
      border-radius: 10px;
      font-size: 18px;
      cursor: pointer;
    }

    .mobile-drawer {
      display: none;
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 16px 24px 20px;
    }
    .mobile-drawer.open { display: block; }
    .mobile-drawer ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .mobile-drawer a {
      display: block; padding: 10px 14px; border-radius: 10px;
      background: var(--sky-50); color: var(--ink-900); font-weight: 500; font-size: 14px;
    }

    /* 3. Airy Mesh Hero + Mahidol Search Dock */
    .hero {
      position: relative;
      padding: 56px 0 64px;
      background-color: #FFFFFF;
      background-image:
        radial-gradient(at 15% 15%, rgba(186, 230, 253, 0.55) 0px, transparent 50%),
        radial-gradient(at 85% 20%, rgba(255, 237, 213, 0.65) 0px, transparent 45%),
        radial-gradient(at 50% 80%, rgba(224, 242, 254, 0.45) 0px, transparent 55%),
        radial-gradient(#CBD5E1 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 100% 100%, 28px 28px;
      border-bottom: 1px solid #F1F5F9;
    }

    .hero-top-meta {
      display: flex;
      justify-content: center;
      margin-bottom: 18px;
    }
    .status-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(2, 132, 199, 0.15);
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 12.5px;
      font-weight: 500;
      color: var(--ink-700);
      box-shadow: var(--shadow-sm);
    }
    .dot-live {
      width: 8px; height: 8px; background: #10B981; border-radius: 50%;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.22);
    }

    .hero-title-wrap {
      text-align: center;
      max-width: 780px;
      margin: 0 auto 30px;
    }
    .hero-title-wrap h2 {
      font-size: clamp(28px, 4.2vw, 40px);
      font-weight: 700;
      color: var(--ink-900);
      line-height: 1.25;
      letter-spacing: -0.4px;
      margin-bottom: 8px;
    }
    .hero-title-wrap h2 span {
      background: linear-gradient(90deg, var(--sky-600), var(--sky-400));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-title-wrap p { font-size: 15.5px; color: var(--ink-500); }

    /* Mahidol-Function Search Dock */
    .search-dock {
      max-width: 880px;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(20px);
      border-radius: var(--radius-xl);
      padding: 18px 22px 20px;
      box-shadow: var(--shadow-lg), 0 0 0 1px rgba(14, 165, 233, 0.14);
    }
    .dock-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .engine-tabs {
      display: inline-flex;
      background: #F1F5F9;
      padding: 4px;
      border-radius: 12px;
    }
    .eng-tab {
      border: none;
      background: transparent;
      padding: 7px 16px;
      border-radius: 9px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      color: var(--ink-500);
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .eng-tab.active {
      background: var(--white);
      color: var(--ink-900);
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    }
    .eng-tab.active i { color: var(--orange-500); }
    .adv-btn {
      font-size: 13px; font-weight: 600; color: var(--sky-600);
      display: inline-flex; align-items: center; gap: 5px;
    }
    .adv-btn:hover { color: var(--orange-500); }

    .search-field-wrap {
      display: flex;
      align-items: center;
      background: var(--white);
      border: 1.5px solid #E2E8F0;
      border-radius: 16px;
      padding: 6px 6px 6px 18px;
      transition: all 0.2s;
    }
    .search-field-wrap:focus-within {
      border-color: var(--sky-500);
      box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
    }
    .search-field-wrap i { color: var(--sky-500); font-size: 18px; margin-right: 12px; }
    .search-field-wrap input {
      flex: 1; border: none; outline: none; font-family: inherit;
      font-size: 15.5px; color: var(--ink-900); background: transparent; min-width: 140px; padding: 8px 0;
    }
    .btn-search {
      background: linear-gradient(135deg, var(--orange-500), var(--orange-400));
      color: var(--white); border: none; padding: 12px 28px; border-radius: 12px;
      font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
      box-shadow: 0 6px 16px rgba(255, 105, 0, 0.28); transition: all 0.2s;
    }
    .btn-search:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(255, 105, 0, 0.36); }

    .filter-chips { display: flex; align-items: center; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
    .filter-chips span { font-size: 12.5px; font-weight: 600; color: var(--ink-500); }
    .chip {
      border: 1px solid #E2E8F0; background: var(--white); color: var(--ink-700);
      padding: 5px 14px; border-radius: 20px; font-family: inherit; font-size: 12.5px; font-weight: 500;
      cursor: pointer; transition: all 0.2s;
    }
    .chip:hover { border-color: var(--sky-400); color: var(--sky-600); }
    .chip.active { background: var(--sky-600); border-color: var(--sky-600); color: var(--white); font-weight: 600; }

    /* Quick Services Floating Dock */
    .quick-dock {
      max-width: 1060px;
      margin: 34px auto 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
    }
    .qd-item {
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 16px;
      padding: 16px 10px;
      text-align: center;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-sm);
    }
    .qd-item:hover { transform: translateY(-4px); border-color: var(--sky-400); box-shadow: var(--shadow-md); background: var(--white); }
    .qd-icon {
      width: 44px; height: 44px; margin: 0 auto 10px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center; font-size: 18px; transition: transform 0.25s;
    }
    .qd-item:nth-child(odd) .qd-icon { background: var(--sky-100); color: var(--sky-600); }
    .qd-item:nth-child(even) .qd-icon { background: var(--orange-50); color: var(--orange-500); }
    .qd-item:hover .qd-icon { transform: scale(1.1); }
    .qd-item h4 { font-size: 13.5px; color: var(--ink-900); font-weight: 600; line-height: 1.3; }
    .qd-item span { font-size: 11px; color: var(--ink-500); display: block; margin-top: 2px; }

    /* Sections */
    .sec { padding: 64px 0; }
    .sec-tinted { background: linear-gradient(180deg, #F4FAFF 0%, #FFFFFF 100%); }

    .sec-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .sec-head h3 { font-size: clamp(21px, 2.5vw, 26px); font-weight: 700; color: var(--ink-900); letter-spacing: -0.3px; }
    .sec-head p { font-size: 14px; color: var(--ink-500); margin-top: 2px; }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 30px;
      background: var(--sky-50); color: var(--sky-600); font-size: 13px; font-weight: 600; transition: all 0.2s;
    }
    .btn-ghost:hover { background: var(--sky-600); color: var(--white); }
    .btn-accent {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 30px;
      background: var(--orange-500); color: var(--white); font-size: 13px; font-weight: 600;
      box-shadow: 0 4px 12px rgba(255, 105, 0, 0.22);
    }

    /* 4. Horizontal Banner Slider Mockup (ประชาสัมพันธ์แนวนอน 16:6) */
    .h-banner-slider {
      position: relative;
      background: var(--white);
      border-radius: var(--radius-xl);
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-md);
    }
    .h-slide {
      display: none;
      aspect-ratio: 16 / 6;
      min-height: 280px;
      background: linear-gradient(125deg, #E8F5FF 0%, #FFFFFF 50%, #FFF4ED 100%);
      padding: 32px;
      position: relative;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .h-slide.active { display: flex; }
    .h-slide-inner {
      width: 100%; height: 100%;
      border: 2px dashed #7DD3FC; border-radius: 16px;
      background: rgba(255, 255, 255, 0.65);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 24px; gap: 10px;
    }
    .h-slide-badge {
      background: var(--sky-100); color: var(--sky-600);
      font-size: 12px; font-weight: 700; padding: 4px 14px; border-radius: 20px;
    }
    .h-slide:nth-child(2) .h-slide-badge { background: var(--orange-50); color: var(--orange-500); }
    .h-slide-inner h4 { font-size: clamp(18px, 2.4vw, 24px); color: var(--ink-900); font-weight: 700; }
    .h-slide-inner p { font-size: 14px; color: var(--ink-500); max-width: 560px; }
    .dim-tag {
      font-size: 12px; font-weight: 600; color: var(--sky-600);
      background: var(--white); padding: 5px 14px; border-radius: 8px;
      border: 1px solid var(--border); margin-top: 4px;
    }
    .h-controls {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 24px; background: var(--white); border-top: 1px solid #F1F5F9;
    }
    .h-dots { display: flex; gap: 8px; }
    .h-dot { width: 24px; height: 6px; border-radius: 4px; background: #CBD5E1; cursor: pointer; transition: all 0.2s; }
    .h-dot.active { background: var(--orange-500); width: 38px; }
    .h-nav { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; color: var(--sky-600); }
    .h-arrow {
      width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border);
      background: var(--sky-50); color: var(--sky-600); cursor: pointer; transition: all 0.2s;
    }
    .h-arrow:hover { background: var(--orange-500); color: var(--white); border-color: var(--orange-500); }

    /* 5. New Arrivals (3D CSS Book Mockups) */
    .books-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
    .book-card {
      background: var(--white); border: 1px solid #F1F5F9; border-radius: var(--radius-lg);
      padding: 20px 14px 16px; text-align: center; box-shadow: var(--shadow-sm); transition: all 0.25s;
    }
    .book-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--sky-100); }
    .book-3d {
      width: 128px; height: 184px; margin: 0 auto 14px; border-radius: 4px 10px 10px 4px;
      padding: 14px 12px; color: var(--white); text-align: left;
      display: flex; flex-direction: column; justify-content: space-between; position: relative;
      box-shadow: -8px 10px 20px rgba(15, 23, 42, 0.14), inset 4px 0 6px rgba(255, 255, 255, 0.25);
      transition: transform 0.3s ease;
    }
    .book-card:hover .book-3d { transform: perspective(600px) rotateY(-12deg) translateY(-4px); }
    .bc-1 { background: linear-gradient(145deg, #0284C7, #0369A1); }
    .bc-2 { background: linear-gradient(145deg, #0EA5E9, #2563EB); }
    .bc-3 { background: linear-gradient(145deg, #FF6900, #EA580C); }
    .bc-4 { background: linear-gradient(145deg, #0D9488, #0284C7); }
    .bc-5 { background: linear-gradient(145deg, #6366F1, #0EA5E9); }
    .book-3d small { font-size: 9.5px; text-transform: uppercase; opacity: 0.85; font-weight: 600; }
    .book-3d strong { font-size: 12.5px; line-height: 1.3; display: block; margin-top: 4px; }
    .book-3d em { font-style: normal; font-size: 10px; opacity: 0.85; border-top: 1px solid rgba(255,255,255,0.25); padding-top: 6px; }
    .book-card h5 { font-size: 13.5px; color: var(--ink-900); line-height: 1.35; margin-bottom: 4px; }
    .book-card span { font-size: 11.5px; color: var(--sky-600); font-weight: 500; }

    /* 6. Bento Grid Mockup for Spaces & EdTech */
    .bento-spaces {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: 220px 220px;
      gap: 18px;
    }
    .bento-mock {
      position: relative; border-radius: var(--radius-xl); padding: 24px;
      display: flex; flex-direction: column; justify-content: space-between;
      border: 1.5px solid var(--border); transition: all 0.25s ease; overflow: hidden;
    }
    .bento-mock:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--sky-400); }
    .bento-mock.featured { grid-column: span 2; grid-row: span 2; background: linear-gradient(145deg, #E0F2FE 0%, #F4FAFF 60%, #FFFFFF 100%); }
    .bento-mock.wide { grid-column: span 2; background: linear-gradient(135deg, #F4FAFF 0%, #FFF4ED 100%); }
    .bento-mock.small-sky { background: linear-gradient(145deg, #F0F9FF 0%, #FFFFFF 100%); }
    .bento-mock.small-orange { background: linear-gradient(145deg, #FFF4ED 0%, #FFFFFF 100%); }

    .bento-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .bento-pill {
      background: var(--white); color: var(--sky-600); font-size: 11.5px; font-weight: 700;
      padding: 4px 12px; border-radius: 20px; border: 1px solid var(--border);
    }
    .bento-mock.small-orange .bento-pill { color: var(--orange-500); border-color: #FED7AA; }
    .bento-ico {
      width: 48px; height: 48px; border-radius: 14px; background: var(--white);
      color: var(--sky-600); display: flex; align-items: center; justify-content: center;
      font-size: 20px; box-shadow: var(--shadow-sm);
    }
    .bento-mock.featured .bento-ico { width: 60px; height: 60px; font-size: 26px; background: var(--sky-600); color: var(--white); }
    .bento-mock.small-orange .bento-ico { color: var(--orange-500); }
    .mock-img-hint {
      margin: auto 0; text-align: center; padding: 14px; border-radius: 14px;
      border: 1.5px dashed rgba(2, 132, 199, 0.25); background: rgba(255, 255, 255, 0.6);
      font-size: 12px; color: var(--ink-500); font-weight: 500;
    }
    .bento-bottom h4 { font-size: 17px; color: var(--ink-900); font-weight: 700; margin-bottom: 4px; }
    .bento-mock.featured .bento-bottom h4 { font-size: 23px; }
    .bento-bottom p { font-size: 13px; color: var(--ink-500); }

    /* 7. KM Videos + Training Schedule */
    .km-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 24px; }
    .surface-card {
      background: var(--white); border: 1px solid #EEF2F6; border-radius: var(--radius-xl);
      padding: 26px; box-shadow: var(--shadow-sm);
    }
    .vid-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .vid-item { border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border); background: var(--white); transition: all 0.2s; }
